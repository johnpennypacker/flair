{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "flair/metric",
  "version": "0.1.0",
  "title": "Metric",
  "category": "flair",
  "description": "Display stats in style",
  "keywords": [
    "number",
    "percentage",
    "metric",
    "data"
  ],
  "example": {},
  "supports": {
    "anchor": true,
    "color": {
      "text": true,
      "link": true,
      "background": true
    },
    "shadow": false,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": false
    },
    "typography": {
      "textAlign": true
    }
  },
  "textdomain": "flair",
  "attributes": {
    "number": {
      "type": "string"
    },
    "qualifier": {
      "type": "string"
    },
    "alignment": {
      "type": "string",
      "default": "center"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}