{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "flair/carousel",
  "version": "0.1.0",
  "title": "Carousel",
  "category": "flair",
  "description": "A slider.",
  "icon": "format-gallery",
  "supports": {
    "align": true,
    "html": false,
    "layout": null,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "typography": {
      "textAlign": true
    }
  },
  "attributes": {
    "perpage": {
      "type": "string",
      "default": "1"
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    }
  },
  "example": {},
  "textdomain": "flair",
  "editorStyle": "file:./index.css",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}