{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "flair/tabs",
	"version": "0.1.0",
	"title": "Tabs",
	"category": "flair",
	"description": "An accessible tabbed interface.",
	"icon": "table-row-after",
	"supports": {
		"align": true,
		"html": false,
		"layout": null,
